# --- Supabase (waitlist + landing signups + student portal auth) ---
# Use either SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL for the project URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Browser auth (required for /login, /signup, /portal)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Legacy JWT service role, or use new secret key in SUPABASE_SECRET_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# New format (sb_secret_…) — use this OR SUPABASE_SERVICE_ROLE_KEY, not both placeholders.
SUPABASE_SECRET_KEY=

# Public site URL (Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (student membership checkout; optional until keys are ready) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ELITE=

# --- Anthropic (admin newsletter generator) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Beehiiv (public newsletter list + admin draft push) ---
BEEHIIV_API_KEY=your_beehiiv_api_key
BEEHIIV_PUBLICATION_ID=your_publication_uuid

# --- Operator portal (/operator) ---
# Defaults if unset: username `test`, password `Sean1234!`
OPERATOR_USERNAME=test
ADMIN_PASSWORD=Sean1234!

# Copy this file to .env.local in the project root (same folder as package.json), then restart npm run dev.

# --- Newsletter generator (legacy OpenAI route) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Weekly email cron (optional: POST /api/admin/cheat-sheet/cron) ---
CRON_SECRET=generate-a-long-random-string
